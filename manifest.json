{
  "manifest_version": 3,
  "name": "Unframe",
  "version": "1.0.0",
  "description": "Encuentra el reproductor de vídeo incrustado en webs llenas de anuncios y ábrelo limpio, sin publicidad, con un clic.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unframe",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
